# =============================================================================
# RestroFlow — The Intelligent Cloud Restaurant OS & POS
# Environment Configuration
# =============================================================================

# Your Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon / Publishable Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Your Supabase Secret Service Role Key (used for server-side route handlers)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL for the Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
